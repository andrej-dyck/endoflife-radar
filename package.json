{
  "name": "endoflife-radar",
  "description": "An end-of-life radar (dashboard) for your projects using endoflife.date",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "tsc",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:ci": "vitest run --mode CI",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh-pages": "tsc && vite build --base=/endoflife-radar",
    "preview": "vite preview"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engine-strict": true,
  "engines": {
    "npm": "use pnpm",
    "yarn": "use pnpm",
    "pnpm": ">=12"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "fast-fuzzy": "1.12.0",
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "5.3.3",
    "react-i18next": "17.0.11",
    "react-intersection-observer": "10.1.0",
    "react-router": "8.3.0",
    "swr": "2.4.2",
    "tailwind-merge": "3.6.0",
    "ts-pattern": "5.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/eslint": "9.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-router": "5.1.20",
    "@vitejs/plugin-react": "6.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "30.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
