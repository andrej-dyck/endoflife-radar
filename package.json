{
  "name": "endoflife-radar",
  "description": "An end-of-life radar (dashboard) for your projects using endoflife.date",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "tsc",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:ci": "vitest run --mode CI",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh-pages": "tsc && vite build --base=/endoflife-radar",
    "preview": "vite preview"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "engine-strict": true,
  "engines": {
    "npm": "use pnpm",
    "yarn": "use pnpm",
    "pnpm": ">=10.20.0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "fuzzy": "0.1.3",
    "i18next": "26.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hotkeys-hook": "5.3.3",
    "react-i18next": "17.0.9",
    "react-intersection-observer": "10.1.0",
    "react-router": "8.2.0",
    "swr": "2.4.2",
    "tailwind-merge": "3.6.0",
    "ts-pattern": "5.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/eslint": "9.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-router": "5.1.20",
    "@vitejs/plugin-react": "6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.6.0",
    "eslint-plugin-better-tailwindcss": "4.6.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
