{
  "name": "endoflife-radar",
  "description": "An end-of-life radar (dashboard) for your projects using endoflife.date",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "tsc",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:ci": "vitest run --mode CI",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh-pages": "tsc && vite build --base=/endoflife-radar",
    "preview": "vite preview"
  },
  "packageManager": "pnpm@12.23.0",
  "engine-strict": true,
  "engines": {
    "npm": "use pnpm",
    "yarn": "use pnpm",
    "pnpm": ">=12"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "fast-fuzzy": "1.12.0",
    "i18next": "27.2.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hotkeys-hook": "5.4.0",
    "react-i18next": "18.0.3",
    "react-intersection-observer": "11.0.1",
    "react-router": "8.5.3",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.1",
    "ts-pattern": "5.9.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.10",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/react-router": "5.1.20",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
